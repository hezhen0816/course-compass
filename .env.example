# Web (public settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_URL=http://127.0.0.1:8001

# Backend and iOS (URL and public key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
BACKEND_SERVICE_BASE_URL=

# Backend only
SUPABASE_SERVICE_ROLE_KEY=
# Generate with openssl rand -hex 32 for encrypted GPA and monitor notification settings.
COURSE_COMPASS_ENCRYPTION_SECRET=
# Comma-separated deployed Web origins. Local Vite origins are allowed by default.
CORS_ORIGINS=
NTUST_VERIFY_SSL=true

# Optional worker configuration
NTUST_SEMESTER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=

# Optional outbound proxy for NTUST requests
NTUST_PROXY_TYPE=
NTUST_PROXY_HOST=
NTUST_PROXY_PORT=
NTUST_PROXY_USERNAME=
NTUST_PROXY_PASSWORD=
